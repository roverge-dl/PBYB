{
  "name": "pbyb-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--experimental-strip-types node --import=@poppinss/ts-exec bin/server.js",
    "build": "cross-env NODE_OPTIONS=--experimental-strip-types node --import=@poppinss/ts-exec ace.js build",
    "dev": "cross-env NODE_OPTIONS=--experimental-strip-types node --import=@poppinss/ts-exec ace.js serve --hmr",
    "ace": "cross-env NODE_OPTIONS=--experimental-strip-types node --import=@poppinss/ts-exec ace.js",
    "test": "cross-env NODE_OPTIONS=--experimental-strip-types node --import=@poppinss/ts-exec ace.js test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#validators/*": "./app/validators/*.js",
    "#utils/*": "./app/utils/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@adonisjs/vite": "^6.0.3",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.5.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "~25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.4",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-ses": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@inertiajs/react": "^3.9.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "edge.js": "^6.5.1",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^1.57.0",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.7.0"
  }
}
